# Copy to .env and fill in real values. Never commit .env.

NODE_ENV=development
PORT=8080
# Comma separated origins for the web admin panel; "*" for any (mobile apps send no Origin)
CORS_ORIGINS=*
# Public URL of this API - used for seeded ad images served from /static
PUBLIC_BASE_URL=http://localhost:8080

# PostgreSQL (docker compose up -d starts one on port 5433)
DATABASE_URL=postgresql://shala:shala_dev_password@localhost:5433/shala_sangathi?schema=public

# JWT secrets - use long random strings (e.g. `openssl rand -hex 32`)
ACCESS_TOKEN_SECRET_KEY=change-me-access-secret
REFRESH_TOKEN_SECRET_KEY=change-me-refresh-secret

# Students who register with this code get free access as our own school students
SCHOOL_ACCESS_CODE=SHALA2026
SCHOOL_NAME="શાળા સંગાથી વિદ્યાલય"

# Paid plan for students of other schools - in paise (1000 = ₹10 / month)
SUBSCRIPTION_MONTHLY_PRICE_PAISE=1000

# AI question generation (Claude). Leave empty to use the SDK's default credential lookup.
ANTHROPIC_API_KEY=
AI_QUESTION_MODEL=claude-opus-5-5

# Demo accounts created by `npm run db:seed` (development only).
# These defaults are public - set your own before seeding any shared or production database.
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_EMAIL=admin@shalasangathi.in
SEED_ADMIN_MOBILE=9000000001
SEED_ADMIN_PASSWORD=Admin@12345
SEED_STUDENT_PASSWORD=Student@123

# Razorpay - online purchase of the paid plan (leave empty to keep it switched off).
# Dashboard > Account & Settings > API keys (use Test Mode keys first).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard > Webhooks: URL https://<your-api>/api/v1/payments/razorpay/webhook,
# events payment_link.paid, payment_link.expired, payment_link.cancelled
RAZORPAY_WEBHOOK_SECRET=
