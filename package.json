{
	"name": "shala-sangathi-backend",
	"version": "1.0.0",
	"description": "Backend API for Shala Sangathi - GSEB Gujarati medium Std 1 to 10 learning app",
	"main": "dist/index.js",
	"private": true,
	"scripts": {
		"dev": "tsx watch index.ts",
		"build": "prisma generate && tsc",
		"start": "node dist/index.js",
		"prod": "prisma migrate deploy && node dist/index.js",
		"typecheck": "tsc --noEmit",
		"lint": "eslint .",
		"prisma:generate": "prisma generate",
		"prisma:migrate": "prisma migrate dev",
		"db:seed": "prisma db seed"
	},
	"engines": {
		"node": ">=20.19.0"
	},
	"author": "Codalent",
	"license": "UNLICENSED",
	"dependencies": {
		"@anthropic-ai/sdk": "^0.133.0",
		"@prisma/adapter-pg": "^7.10.0",
		"@prisma/client": "^7.10.0",
		"bcryptjs": "^3.0.3",
		"cors": "^2.8.6",
		"dotenv": "^18.0.7",
		"express": "^5.3.0",
		"express-rate-limit": "^8.7.1",
		"express-validator": "^7.3.2",
		"helmet": "^8.3.0",
		"jsonwebtoken": "^9.0.3",
		"morgan": "^1.12.1",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/cors": "^2.8.19",
		"@types/express": "^5.0.6",
		"@types/jsonwebtoken": "^9.0.10",
		"@types/morgan": "^1.9.10",
		"@types/node": "^20.19.43",
		"eslint": "^10.12.0",
		"prisma": "^7.10.0",
		"tsx": "^4.23.15",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.71.2"
	}
}
